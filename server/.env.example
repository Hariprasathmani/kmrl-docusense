# server/.env â€” copy this file to .env and fill in your values

PORT=5000
MONGO_URI=mongodb://localhost:27017/kmrl_docusense
NODE_ENV=development

# JWT â€” change JWT_SECRET to a long random string in production
JWT_SECRET=kmrl_docusense_super_secret_key_change_in_prod
JWT_EXPIRES_IN=7d

# Optional AI enrichment service. Uploads remain stored and tickets are created
# even when this service is unavailable.
AI_SERVICE_URL=http://localhost:8000
AI_REQUEST_TIMEOUT_MS=8000

# ═══════════════════════════════════════════════════════════════
# Email Ingestion via Gmail API + OAuth 2.0
# ═══════════════════════════════════════════════════════════════
# To setup Gmail API OAuth:
# 1. Create Google Cloud project: https://console.cloud.google.com/
# 2. Enable Gmail API
# 3. Create OAuth 2.0 credentials
# 4. Add redirect URI: http://localhost:5000/auth/google/callback
# 5. Run: node scripts/setupGmailOAuth.js
# 6. Copy credentials from script output to below

EMAIL_PROCESSING_ENABLED=false

# Gmail API OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GMAIL_USER_EMAIL=

# Optional: Polling interval in milliseconds (default: 60000 = 1 minute)
# GMAIL_POLL_INTERVAL_MS=60000

# Optional: Retry interval when OAuth fails (default: 300000 = 5 minutes)
# EMAIL_RETRY_INTERVAL_MS=300000

